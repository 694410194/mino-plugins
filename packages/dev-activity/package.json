{
  "name": "mino-connector-dev-activity",
  "version": "0.1.1",
  "description": "开发活动连接器：本机 git 提交记录 + shell 命令历史，看最近在写什么、跑过什么命令。只读、本地、零配置。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mino-connector",
    "dev-activity"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hostdeps.mjs",
    "skill-provider.mjs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.3.0",
    "node": ">=20.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/694410194/mino-plugins.git",
    "directory": "packages/dev-activity"
  },
  "bugs": {
    "url": "https://github.com/694410194/mino-plugins/issues"
  }
}
