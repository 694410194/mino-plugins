{
  "name": "mino-connector-wechat",
  "version": "0.1.0",
  "description": "微信本地语料连接器：定位 WeChat 数据目录/进程，封装导出引擎（wechat-dump-rs/PyWxDump）做内存取钥+库解密，明文落 chat.db 检索。特区解封，用户自己的数据。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mino-connector",
    "wechat"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hostdeps.mjs",
    "skill-provider.mjs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.3.0",
    "node": ">=20.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/694410194/mino-plugins.git",
    "directory": "packages/wechat"
  },
  "bugs": {
    "url": "https://github.com/694410194/mino-plugins/issues"
  }
}