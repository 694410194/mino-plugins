{
  "name": "mino-brief",
  "version": "0.1.0",
  "description": "早晚简报：专用简报员会话每天定时醒来，把值得留意的事写进「今日」页。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "briefing",
    "today"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-alpha.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "license": "MIT"
}
