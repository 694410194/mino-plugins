{
  "name": "mino-connector-portfolio",
  "version": "0.1.0",
  "description": "行情与持仓连接器：查股票/基金实时价，算自己持仓的盈亏。公共行情接口只收证券代码，持仓数据不出本机。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mino-connector",
    "stock",
    "fund",
    "portfolio",
    "finance"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hostdeps.mjs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.3.0",
    "node": ">=20.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/694410194/mino-plugins.git",
    "directory": "packages/portfolio"
  },
  "bugs": {
    "url": "https://github.com/694410194/mino-plugins/issues"
  }
}
