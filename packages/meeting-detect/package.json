{
  "name": "mino-meeting-detect",
  "version": "0.1.0",
  "description": "会议临近检测：轮询日历，临近日程自动排一次性提醒到专用会话，提醒模型问用户要不要开录音。",
  "keywords": ["dsh", "dsh-plugin", "meeting", "calendar"],
  "type": "module",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "scripts": { "build": "tsdown", "typecheck": "tsc --noEmit" },
  "dependencies": { "zod": "4.4.3" },
  "devDependencies": { "@types/node": "22.20.0", "tsdown": "0.22.14", "typescript": "6.0.3" },
  "dsh": {
    "engines": { "dsh": ">=0.2.2-alpha.1 <0.3.0" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "manifestVersion": 1
  },
  "files": ["lib", "cordis.patch.yml"],
  "license": "MIT"
}
