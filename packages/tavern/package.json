{
  "name": "dsh-sillytavern",
  "version": "1.1.1",
  "description": "Mino SillyTavern-compatible preset: character cards, worldbooks, macros, MVU (fork of dsh-sillytavern)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "dsh-plugin.json",
    "scripts",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/sillytavern.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sillytavern",
    "tavern",
    "roleplay",
    "trpg"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "KamishiroRei",
  "repository": {
    "type": "git",
    "url": "https://github.com/KamishiroRei/dsh-sillytavern"
  },
  "homepage": "https://github.com/KamishiroRei/dsh-sillytavern",
  "mino": {
    "upstream": "KamishiroRei/dsh-sillytavern"
  }
}
