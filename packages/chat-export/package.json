{
  "name": "mino-connector-chat-export",
  "version": "0.1.0",
  "description": "聊天记录连接器：读用户自己用导出工具产出的明文聊天导出文件（微信/QQ/TG/QQ空间），建索引供检索。洛雪壳形态：本体零解密。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mino-connector",
    "chat-export"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hostdeps.mjs",
    "skill-provider.mjs",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.3.0",
    "node": ">=20.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/694410194/mino-plugins.git",
    "directory": "packages/chat-export"
  },
  "bugs": {
    "url": "https://github.com/694410194/mino-plugins/issues"
  }
