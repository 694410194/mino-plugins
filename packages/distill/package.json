{
  "name": "mino-distill",
  "description": "会话蒸馏（fork @loserfox/distill）：turn 结束后后台 subagent 反思，自动把经验写成/更新成 SKILL.md —— 「带它走一遍就学会」的技能沉淀。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.3.0"
  },
  "mino": {
    "upstream": "@loserfox/distill@0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loserfox/distill"
  },
  "homepage": "https://github.com/694410194/mino-plugins/tree/main/packages/distill#readme",
  "author": "loserfox"
}
