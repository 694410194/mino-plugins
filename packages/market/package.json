{
  "name": "dshmarket",
  "description": "Visual plugin market inside DeepSeek Harness — browse, search, and one-click install community plugins. · DSH 可视化插件市场：逛一逛，点一下，装好。",
  "version": "1.73.7",
  "icon": "assets/logo.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-market/dsh-market.git"
  },
  "homepage": "https://dshmarket.com",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "marketplace",
    "market",
    "plugin-manager"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "check": "npm run typecheck && npm run build && node scripts/restart-smoke.mjs",
    "test": "vitest run",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "prepack": "npm run build && node scripts/preflight.mjs",
    "prepare": "npm run build",
    "validate:registry": "node scripts/validate-registry.mjs",
    "snapshot": "mkdir -p data && curl -sf https://awesome-dsh-plugin.com/plugins.json -o data/registry-snapshot.json && curl -sf https://awesome-dsh-plugin.com/readmes.json -o data/readmes-snapshot.json",
    "check:web-auth-capture": "node scripts/check-web-auth-capture.mjs",
    "test:web": "node scripts/check-web-auth-capture.mjs && vitest run --config vitest.web.config.ts",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@shikijs/langs": "^4.4.3",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "28.0.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "anser": "^2.3.5",
    "clsx": "2.1.1",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "jsdom": "29.1.1",
    "katex": "^0.18.7",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "playwright": "1.58.2",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "16.31.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zustand": "~4.5.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./update-api-v1": {
      "types": "./lib/types/update-api-v1.d.ts",
      "default": "./lib/update-api-v1.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets/logo.svg",
    "locale",
    "lib",
    "client",
    "UPDATE-API-V1.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "private": true,
  "author": "fkysly and dsh-market contributors",
  "mino": {
    "upstream": "dsh-market/dsh-market"
  }
}
