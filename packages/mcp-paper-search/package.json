{
  "name": "mino-mcp-paper-search",
  "version": "0.1.1",
  "description": "MCP 接入包（上游 openags/paper-search-mcp 官方 dsh bundle）：拉起 paper-search-mcp 服务器，mcp__paper-search__* 工具覆盖 arXiv/PubMed/Semantic Scholar/Crossref/OpenAlex 等 15+ 源检索下载；随包附 paper-search 使用技能。需本机 uv/uvx。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "papers",
    "academic-search",
    "arxiv",
    "pubmed",
    "semantic-scholar",
    "openalex"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openags/paper-search-mcp",
    "directory": "dsh"
  },
  "homepage": "https://github.com/openags/paper-search-mcp",
  "mino": {
    "upstream": "openags/paper-search-mcp@cab1b5c"
  },
  "author": "P.S Zhang <pengsongzhang96@gmail.com>",
  "icon": "icon.svg",
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2"
  }
}
