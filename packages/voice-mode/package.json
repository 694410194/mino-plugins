{
  "name": "dsh-voice-mode",
  "description": "全双工语音模式（fork dsh-voice-mode）：本地流式 ASR 写入可编辑草稿、逐句朗读带字幕、说话即打断（barge-in）、可选唤醒词。Edge 在线或本地 VITS/Kokoro TTS。",
  "icon": "./icon.svg",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/msedge-tts.cjs",
    "lib/tts-vits-worker.cjs",
    "lib/client.js",
    "lib/sense-worker.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/architecture.svg",
    "scripts/prefetch.mjs",
    "scripts/list-voices.mjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md"
  ],
  "scripts": {
    "prefetch": "node scripts/prefetch.mjs",
    "list-voices": "node scripts/list-voices.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "sherpa-onnx": "^1.13.6",
    "sherpa-onnx-node": "1.13.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "mino": {
    "upstream": "dsh-voice-mode@0.7.34"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "full-duplex",
    "barge-in",
    "local-asr",
    "sensevoice"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qishuilalala/dsh-voice-mode"
  },
  "homepage": "https://github.com/694410194/mino-plugins/tree/main/packages/voice-mode#readme",
  "author": "qishuilalala"
}
