{
  "name": "mino-mcp-github",
  "version": "0.1.0",
  "description": "MCP 接入包：GitHub 官方远端 MCP 服务器（streamable-http，需 GITHUB_TOKEN，未配置时行自动停用）。安装即挂载一条 dsh-mcp-client 配置行。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "github",
    "streamable-http"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/694410194/mino-plugins.git",
    "directory": "packages/mcp-github"
  },
  "homepage": "https://github.com/694410194/mino-plugins/tree/main/packages/mcp-github#readme",
  "icon": "icon.svg",
  "main": "index.js",
  "mino": {
    "upstream": "github/github-mcp-server"
  }
}
