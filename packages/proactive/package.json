{
  "name": "dsh-proactive",
  "version": "0.1.1",
  "description": "Host 级主动唤醒（fork dsh-proactive）：模型自订闹钟（单次/循环/cron+抖动）、冷会话到点 resume、安静时段与每日投递预算、静默唤醒墓碑折叠，自带闹钟管理面板。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proactive",
    "scheduler",
    "cron",
    "wake-up",
    "主动唤醒",
    "定时任务"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.2-alpha.1 <0.3.0"
  },
  "mino": {
    "upstream": "dsh-proactive@0.3.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/john-walks-slow/dsh-proactive"
  },
  "homepage": "https://github.com/694410194/mino-plugins/tree/main/packages/proactive#readme",
  "author": "john-walks-slow"
}
