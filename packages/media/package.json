{
  "name": "mino-media",
  "version": "0.1.0-alpha.1",
  "description": "Mino 媒体生成插件——视频、语音合成、语音转写、音乐，经 mino-inference 服务走 Mino 账号额度。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mino",
    "video",
    "tts",
    "stt",
    "music"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hostdeps.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.2 <0.3.0",
