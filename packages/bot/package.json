{
  "name": "mino-bot",
  "version": "0.1.2",
  "type": "module",
  "description": "个人 Agent 工作区（fork MJ-CJM/DSH-Bot 的 dsh-bot）：多个有名有姓的 Bot，各自人设、长期记忆、工具与技能，群组协作与任务交接，后台任务与凭据编辑。",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./bot-context": {
      "types": "./lib/host/bot-context.d.ts",
      "default": "./lib/host/bot-context.js"
    },
    "./host-contract": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./group-root-guard": {
      "types": "./lib/host/groups/root-guard.d.ts",
      "default": "./lib/host/groups/root-guard.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server-memory": "2026.7.4",
    "js-yaml": "4.1.1",
    "zod": "4.4.3"
  },
  "mino": {
    "upstream": "dsh-bot@0.6.3"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "personal-agents",
    "bots",
    "multi-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/694410194/mino-plugins",
    "directory": "packages/bot"
  },
  "homepage": "https://github.com/694410194/mino-plugins/tree/main/packages/bot#readme"
}