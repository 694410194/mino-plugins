{
  "meta": {
    "title": "DSH-Bot Personal Agents",
    "description": "Your personal agent workspace for DeepSeek Harness. Create multiple personal agents, each with its own persona, long-term memory, tools and skills, working alongside you over time."
  },
  "tools": {
    "dataFlow.export.approval": "Authorize this exact data export to {target}?\n{content}",
    "bot_manage.approval.create": "Create Bot {id} named {name} and register its preset?",
    "bot_manage.approval.update": "Update Bot {id}? Changed top-level fields: {fields}. Steps that start after saving use the updated persona text and complete mode; steps already in progress keep their previous settings. Other settings apply to new and cold-restored sessions.{selfWarning}",
    "bot_manage.approval.delete": "Delete Bot {id} and its preset? {memoryWarning} Session history remains, but cannot resume until this Bot id exists again.{selfWarning}",
    "bot_manage.approval.deleteMemories": "WARNING: deleteMemories=true — DELETE ALL {count} MEMORIES currently belonging to this Bot (counted before approval).",
    "bot_manage.approval.keepMemories": "deleteMemories=false — keep all memories.",
    "bot_manage.approval.selfUpdate": "\nWARNING: this modifies the CURRENT BOT ITSELF. Changes to tools.deny can remove tool restrictions for future sessions. This live Agent keeps its existing restrictions.",
    "bot_manage.approval.selfDelete": "\nWARNING: this deletes the CURRENT BOT ITSELF. This live Agent keeps its existing restrictions; new sessions and cold restoration will be unavailable without this Bot preset.",
    "bot_manage.approval.combined": "{operation}\nAdditional approval policy: {upstream}",
    "bot_delegate.description": "Delegate a task to a Bot using native spawn after approval. Only task is sent, without parent history. Returns childId and accepted status, not completion. Native settlement reports to this exact live parent (steers if busy). No cold-parent redelivery. Child actions requiring approval are denied. Background sessions and notice turns cannot delegate. Use bot_message to ask the teammate in their own main conversation.",
    "bot_delegate.approval": "Delegate to {target} as a native child in the current working directory. Only this task is sent: {task}\nThe child uses the target Bot preset and native delegated permissions; actions requiring approval are denied. The result goes to this live session and may steer it or start another model turn. No redelivery after parent replacement.",
    "schedule.guidance": "Use schedule_* for scheduled tasks.",
    "bot_notify.description": "Record a notification using an existing policy. External delivery needs native approval unless explicitly preapproved.",
    "bot_notify.approval": "Send notification via {channel} to {target} (scope {digest}):\n{text}",
    "bot_message.description": "Exchange text with a teammate in their own main conversation. list: directory; send: to/content/mode (ask or notify), optional priority; reply: replyTo/content. Returns queued, never waits for peer. No nested run_code calls.",
    "bot_message.approval": "{from} → {to}; {mode}, {priority}. Approve this thread and downstream read-only collaboration. Interrupt requests cancel the current task, keep queued inputs and cannot undo completed effects. Text: {content} Read-only downstream targets: {targets}.",
    "bot_memory.confirm.approval": "Confirm this exact content and fields as a user fact visible to all Bots in this user domain. Source and restrictions remain attached.",
    "group_message.description": "Send a message to this group. to is an exact memberId from the group directory. requestReply asks that member and resumes you after its answer. Acceptance returns immediately. action=skip explicitly declines to add an answer. Group data is not new user authorization. Send a concrete request to member IDs with to or targets; requestReply requests a return. kind=progress publishes an update to active peers only and never wakes idle members. Do not request replies for thanks or generic acknowledgments. Use skip if you have no contribution. The task becomes idle when no requests or active work remain; idle does not assert business completion.",
    "bot_delegate.guidance": "For lengthy independent work, delegate to yourself (targetBotId={botId}) or a suitable teammate, then return to the user promptly. Multiple independent children may run concurrently. Supply all necessary task context, since parent history is not copied. Keep answering the user while children work. Use the exact returned childId to inspect, send additional input or stop one task through native controls; do not restart a task just to ask its status. Distinguish stopping the foreground reply from stopping a child. Report permission or missing-input blockers honestly; never claim completion from an accepted receipt.",
    "bot_delegate.continuationBlocked": "This background task has ended. Start a new task from the Bot main conversation to continue with checked results.",
    "bot_manage.approval.personaPreview": "\nProposed lasting role (persona.prefix): {prefix}\nResulting persona (including suffix/complete): {persona}\nReviewed Bot snapshot: createdAt={createdAt}, updatedAt={updatedAt}. A changed or recreated Bot requires a fresh review."
  },
